# API root (same as {{baseUrl}} in Postman, e.g. https://fcadmin.fctesting.space)
VITE_API_URL=https://fcadmin.fctesting.space
# Public folder where the backend serves filenames returned by `image`.
# Example: https://fcadmin.fctesting.space/uploads/blogs
VITE_BLOG_IMAGE_URL=https://fcadmin.fctesting.space/uploads
# Vite dev proxy for local development (avoids browser CORS)
VITE_DEV_PROXY=true
